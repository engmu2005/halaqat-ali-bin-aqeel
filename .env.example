# إعدادات الخادم — انسخ هذا الملف إلى .env واملأ القيم محلياً.
# لا يُرفع ملف .env إلى GitHub (موجود في .gitignore).
# على Render تُضبط القيم نفسها من لوحة التحكم (Environment) ولا تُكتب في أي ملف.

# بيئة التشغيل: development أو production
NODE_ENV=development

# منفذ الخادم
PORT=8080

# اتصال PostgreSQL
# على Render: ضع DATABASE_URL من لوحة Render (لا تُكتب يدوياً في الكود)
DATABASE_URL=postgres://postgres@localhost:5433/halaqat

# سر الجلسات: قيمة عشوائية طويلة (32 حرفاً على الأقل) — تُولَّد بأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-please

# مدة بقاء تسجيل الدخول (بالأيام)
SESSION_TTL_DAYS=30
